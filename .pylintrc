# Pylint configuration for the ledger scripts under notes/scripts/, including the extracted checker
# self-tests under notes/scripts/tests/ (math-e8k).
#
# Gate command: `.venv/bin/pylint notes/scripts/` — it must exit 0.
# Every rule below that is disabled carries the count it was measured at and the reason the finding
# is not a defect. The counts are re-derivable: `PYTHONPATH=notes/scripts .venv/bin/pylint
# --disable=all --enable=<code> notes/scripts/` prints them. Measured 2026-10-12 over the 79-file
# tree: 1,634 findings. Pylint's default message set is enabled, so what follows is a disable list.
# Codes, not symbolic names: pylint 4.1.2 rejects several of the older symbolic spellings with
# W0012 bad-option-value.

[MAIN]
score = no

[MESSAGES CONTROL]
disable =
    # 818 sites. Report lines embed manuscript paths and verbatim quotations, which are long by
    # construction and must not be wrapped.
    C0301,
    # 268 sites (253 in the script tree, 15 in the extracted self-tests). A report function is a
    # one-purpose helper whose contract is the report line it prints; the module docstring states
    # what the script measures.
    C0116,
    # 158 sites. The report strings are %-formatting templates reused across tiers; this is the
    # same convention ruff's UP031 exemption records.
    C0209,
    # 1 site. build_index.py renders 1,033 pages in one module.
    C0302,
    # 8 sites. Module-level path constants are UPPER_CASE and the extractors use short loop
    # variables; both are the local naming convention (see [BASIC] good-names).
    C0103,
    # 11 sites. A checker that reads a page section by section imports inside the function that
    # needs it; catlib/render.py's lazy import of render_reports is the import cycle it must not
    # close at module level.
    C0415,
    # 1 cycle, one shape: catlib.render -> render_reports -> <measuring script>. The writer
    # imports the scripts whose numbers it renders, and the shared render-diff module imports the
    # writer only inside a function — that deferred import is the recursion guard the sync pass
    # needs (see catlib/render.py's rendered()), and a module-level import would make the writer
    # unimportable from inside a render. Python resolves the graph because the import is deferred
    # to a point where every module is already loaded.
    R0401,
    # 114 / 43 / 42 / 1 / 2 / 2 / 7 / 7 sites. A generator that reconciles a corpus is long and
    # wide by design; the metrics describe the report, not a defect.
    R0914,
    R0912,
    R0915,
    R1702,
    R0911,
    R0903,
    R0917,
    R0913,
    # 48 sites, all of them reported against one file:
    # notes/scripts/tests/test_conjecture_standing.py, whose repeated mutate-then-assert shape is
    # the point of one test per defect. The checker-to-checker duplication (the anchor/fence loops)
    # and extract-to-verify, which math-lon.2 removes when the checkers move onto the package,
    # measured 0 in the 79-file tree.
    R0801,
    # 3 sites. The report accumulators are module-level by design.
    W0603,
    # 22 / 57 sites. A checker reuses the ledger's own names (rows, fams) inside a function that
    # reads the same population; the rest are the pytest fixture pattern, where a test's parameter
    # name is the fixture's name by design and pytest injects it, so the shadow is the contract.
    W0621,
    # 19 sites, all of them comprehensions that iterate a dict's keys and index it
    # (`sum(1 for f in fams if ... fams[f]["abstract"] ...)`). The key is the family number the
    # report line names, so the .items() rewrite drops the name the measurement is about.
    C0206,
    # 1 site, the pair window `for i in range(len(ms)): for j in range(i + 1, len(ms)):`,
    # which enumerate does not express.
    C0200,
    # 1 site. catlib/summaries.py's Page class is a parsed-page data holder, not a behaviour class.
    R0902,

[BASIC]
good-names = i,j,k,l,n,f,fp,ts,ex,_,d,ln,rv,ok,p,q,m
