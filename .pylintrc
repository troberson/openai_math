# Pylint configuration for the ledger scripts under notes/scripts/ (math-e8k).
#
# Gate command: `.venv/bin/pylint notes/scripts/` — it must exit 0.
# The counts in the comments are the full-corpus baseline measured on 2026-10-09 (1,422 findings
# over 44 scripts); notes/linting.md records that baseline and the triage. Pylint's default message
# set is enabled, so what follows is a disable list. Codes, not symbolic names: pylint 4.1.2
# rejects several of the older symbolic spellings with W0012 bad-option-value.

[MAIN]
score = no

[MESSAGES CONTROL]
disable =
    # 351 sites. Report lines embed manuscript paths and verbatim quotations, which are long by
    # construction and must not be wrapped.
    C0301,
    # 194 sites. A report function is a one-purpose helper whose contract is the report line it
    # prints; the module docstring states what the script measures.
    C0116,
    # 160 sites. The report strings are %-formatting templates reused across tiers; this is the
    # same convention ruff's UP031 exemption records.
    C0209,
    # 1 site. build_index.py renders 1,033 pages in one module.
    C0302,
    # 12 sites. Module-level path constants are UPPER_CASE and the extractors use short loop
    # variables; both are the local naming convention (see [BASIC] good-names).
    C0103,
    # 6 sites. A checker that reads a page section by section imports inside the function that
    # needs it.
    C0415,
    # 2 sites. A backslash inside a report template string is the report's own formatting.
    C3001,
    # 80 / 37 / 35 / 5 / 3 / 2 / 5 sites. A generator that reconciles a corpus is long and wide by
    # design; the metrics describe the report, not a defect.
    R0914,
    R0912,
    R0915,
    R1702,
    R0911,
    R0903,
    R0917,
    R0913,
    # 24 sites on the baseline, 28 measured 2026-10-09 over 52 files after the shared package
    # landed: the duplication is checker-to-checker (the anchor/fence loops) and extract-to-verify,
    # which math-lon.2 removes when the checkers move onto the package. Count recorded in
    # notes/linting.md.
    R0801,
    # 3 sites. The report accumulators are module-level by design (notes/linting.md).
    W0603,
    # 5 sites. A checker reuses the ledger's own names (rows, fams) inside a function that reads
    # the same population.
    W0621,
    # 6 sites: `prev` is None-guarded in the same `and` clause before it is subscripted
    # (verify_dependency_drift.py:169-170, extract_formalization_deps.py:161-162). pylint does not
    # track the narrowing, so the message is off corpus-wide and the sites are listed in
    # notes/linting.md.
    E1136,
    # 16 sites, all of them comprehensions that iterate a dict's keys and index it
    # (`sum(1 for f in fams if ... fams[f]["abstract"] ...)`). The key is the family number the
    # report line names, so the .items() rewrite drops the name the measurement is about.
    C0206,
    # 4 sites, all the pair window `for i in range(len(ms)): for j in range(i + 1, len(ms)):`,
    # which enumerate does not express.
    C0200,
    # 1 site. verify_summaries.py's Page class is a parsed-page data holder, not a behaviour class.
    R0902,

[BASIC]
good-names = i,j,k,l,n,f,fp,ts,ex,_,d,ln,rv,ok,p,q,m
