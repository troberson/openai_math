# Agent tool state: track the project skills, ignore the rest
.qwen/*
!.qwen/skills/

# Python bytecode from the notes scripts
__pycache__/

# Project venv for the script linters (math-e8k); uv-managed, never tracked
.venv/

# Prettier install; the manifest above is tracked, the tree is not
node_modules/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
